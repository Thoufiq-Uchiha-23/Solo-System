// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTHENTICATION WITH NEXT AUTH & GOOGLE OAUTH
// USER SCHEMA BEING DEFAULT ONLY THING HERE ADDED IS THE ACCOUNT, SESSION, AND VERIFICATION TOKEN MODELS FOR NEXT AUTH
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?            // paste URL here for pfp
  banner        String?
  passwordHash  String?
  name          String?
  totalXp       Int       @default(0)
  level         Int       @default(1)
  socialLinks   Json?              // array of { platform, url }
  createdAt     DateTime  @default(now())

  goals         Goal[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  resources   Json?

  userId      String
  user        User       @relation(fields: [userId], references: [id])

  quests      Quest[]
}

model Quest {
  id          String      @id @default(cuid())
  title       String
  description String?
  order       Int         // sequence within the goal (1, 2, 3...)
  status      QuestStatus @default(PENDING)
  xpReward    Int         @default(10)
  completedAt DateTime?

  goalId      String
  goal        Goal        @relation(fields: [goalId], references: [id])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum QuestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}